`ifndef RVGPU_TYPEDEF_SVH
`define RVGPU_TYPEDEF_SVH

typedef logic               l1_t;
typedef logic [1:0]         l2_t;
typedef logic [2:0]         l3_t;
typedef logic [3:0]         l4_t;
typedef logic [7:0]         l8_t;
typedef logic [15:0]        l16_t;
typedef logic [31:0]        l32_t;
typedef logic [63:0]        l64_t;
typedef logic [127:0]       l128_t;
typedef logic [255:0]       l256_t;

`endif // RVGPU_TYPEDEF_SVH
