# Command VA is 0x1234567100, PA Base 0x20000000 PA offset is 0x100
# command.header.cmd_type = CMD_COMPUTE_JOB; // 4'b0000
# command.header.size = 1; // 3'b1
# command.header.last = 1; // 1'b1
# command.header.job_dim = {{0, 0, 1}, {0, 0, 2}, {0, 4, 32}};
# command.prog.program_addr = 0x1234567100;
# command.prog.argument_size = 3;
# 
# data[31:0] = 8'b10010000 = 0x00000090
# grid_z: 0x0000
# grid_y: 0x0000
# grid_x: 0x0001
# cluster_z + block_z: 0x0000
# cluster_y + block_y: 0x0004
# cluster_x + block_x: 0010_000000100000 = 0x2020
# data[127:32] = 'h00000000_00010000_00042020

0x20000100: 00000090 00000000 00010000 00042020